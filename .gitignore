# Generated by build.py and published straight to Pages by the workflow —
# keeping it out of git stops dev and main from diverging on a build artifact.
index.html
data.json
meta.json
_site/
__pycache__/
.DS_Store
# vim swap files
*.swp
*.swo

# Android build outputs
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
android/local.properties
android/keystore.properties
# signing key (never commit; the public repo is served as-is)
*.jks
*.keystore
# built and published as a GitHub Release by .github/workflows/apk.yml, not kept in git
android/apk/
android/.idea/
*.iml
